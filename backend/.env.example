# backend/.env.example — copy to backend/.env for local development (npm run db:local first).
NODE_ENV=development
PORT=4100
LOG_LEVEL=debug
# The dashboard's origin, as the browser sees it. State-changing requests must come from it (CSRF check).
# Production: the Render URL (or sentinel.<your domain>). Local: http://localhost:5180 with `npm run dev`, :4100 with npm start.
APP_ORIGIN=http://localhost:5180
# Number of proxy hops in front of the API (Render: 1). 0 locally.
TRUST_PROXY=0
# Local cluster from `npm run db:local`. Production: the Neon project "campushub-sentinel", DIRECT endpoint, as the
# least-privilege role sentinel_app (README "Database roles").
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5434/sentinel?sslmode=disable
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# 32+ random bytes, base64. Encrypts TOTP and ingestion secrets and keys every HMAC. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored TOTP secrets unreadable (every developer then re-enrols after admin:reset-mfa).
DATA_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
# Sessions: signed-in state ends after this idle time or this absolute lifetime, whichever comes first.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Sensitive actions (adding a developer, resetting two-step verification) need a fresh confirmation from the last N
# minutes: the password, plus an authenticator code when MFA_MODE=required.
REAUTH_MINUTES=10
# Two-step verification (authenticator codes): off (password only, the default for now) or required.
MFA_MODE=off
# Visitor analytics: DB-IP Lite edition (country | city | off) and the timezone of reports.
GEOIP_EDITION=country
REPORT_TIMEZONE=Asia/Kolkata
# Alert emails: log (default: only written to the log), brevo (sends; needs the two values below), or off.
EMAIL_TRANSPORT=log
BREVO_API_KEY=
ALERT_EMAIL_FROM=
