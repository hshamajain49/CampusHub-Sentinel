# Throwaway values for the local test database only (committed on purpose; never used anywhere else).
NODE_ENV=test
PORT=4110
LOG_LEVEL=silent
APP_ORIGIN=http://localhost:5180
TRUST_PROXY=0
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5434/sentinel_test?sslmode=disable
DATABASE_SSL=false
DATABASE_POOL_MAX=5
DATA_ENCRYPTION_KEY=dGVzdC1vbmx5LWtleS1ub3QtYS1zZWNyZXQtMDEyMzQ1Njc4OQ==
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
REAUTH_MINUTES=10

# The suites exercise two-step verification; auth-mfa-off.test.ts switches it off at run time.
MFA_MODE=required
